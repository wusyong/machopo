package machopo:dom@0.1.0;

/// The world of a page's wasm script (`<script type="application/wasm">` in
/// a wasm document), a component: the DOM's interface imported, and `start`,
/// which the page calls with its document once the script is instantiated.
/// `start` is async: it may wait (the page goes on at its first wait), and
/// may never return.
world script {
  import dom;
  use dom.{document};
  export start: async func(document: document);
}
