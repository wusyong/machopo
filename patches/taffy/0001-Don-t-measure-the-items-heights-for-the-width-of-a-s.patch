diff --git a/tests/hand_written/caching.rs b/tests/hand_written/caching.rs
index 8d58f933120c8ef9a063f6d11a604e9fdfbd0d7a..c35c8743e7ca6f7e1c4422264ee5573e9fff6df4 100644
