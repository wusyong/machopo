@@ -436,6 +432,47 @@ impl<'a, 'b, B: Brush> parley_engine::FontSelector for FontSelector<'a, 'b, B> {
     }
 }
 
+// machopo: the query's part of `select_font`, so that a debug build can run it again.
+/// The first font `query` yields that covers `cluster` completely, else the one that covers the
+/// most of it.
+fn best_font<'q>(query: &'q mut Query<'_>, cluster: &mut CharCluster) -> Option<&'q QueryFont> {
+    let mut selected_font = None;
+    let mut best_coverage = Coverage::NONE;
+
+    query.matches_with(|font| {
+        let Some(charmap) = font.charmap() else {
+            return fontique::QueryStatus::Continue;
+        };
+
+        let coverage = cluster.calculate_coverage(|ch| {
+            charmap
+                .map(ch)
+                .map(|g| {
+                    // Any non-zero value indicates the existence of a glyph.
+                    g != 0
+                })
+                .unwrap_or_default()
+        });
+        if coverage > best_coverage {
+            selected_font = Some(font);
+            best_coverage = coverage;
+
+            if coverage.is_complete() {
+                fontique::QueryStatus::Stop
+            } else {
+                fontique::QueryStatus::Continue
+            }
+        } else {
+            if selected_font.is_none() {
+                selected_font = Some(font);
+            }
+            fontique::QueryStatus::Continue
+        }
+    });
+
+    selected_font
+}
