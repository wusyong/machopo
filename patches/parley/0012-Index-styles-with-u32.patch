+
+/// More styles than a `u16` can index: one per character, each with a brush of its own. The text
+/// is broken into many lines, as a line's span boxes are kept in a list searched for each new one.
+const MANY_STYLES: u32 = 70_000;
+
+/// The family of the last of [`MANY_STYLES`], which the others don't have: an index that wraps
+/// would select the font of the style it wraps to.
+const MANY_STYLES_LAST_FAMILY: &[FontFamilyName<'_>] =
+    &[FontFamilyName::Named(Cow::Borrowed("Arimo"))];
+
+/// The brush of the `i`th of [`MANY_STYLES`].
+fn many_styles_brush(i: u32) -> ColorBrush {
+    let [_, r, g, b] = i.to_be_bytes();
+    ColorBrush::new(peniko::color::AlphaColor::from_rgba8(r, g, b, 255))
+}
+
+/// The last glyph run's style index and brush, and whether its font is other than the first's.
+fn last_glyph_run_style(layout: &Layout<ColorBrush>) -> (u32, ColorBrush, bool) {
+    let mut runs = layout.lines().flat_map(|line| {
+        line.items().filter_map(|item| match item {
+            PositionedLayoutItem::GlyphRun(run) => Some(run),
+            _ => None,
+        })
+    });
+    let first = runs.next().expect("a glyph run");
+    let last = runs.last().expect("another glyph run");
+    let font = |run: &crate::GlyphRun<'_, ColorBrush>| {
+        let font = run.run().font();
+        (font.data.id(), font.index)
+    };
+    (
+        last.style_index(),
+        last.style().brush,
+        font(&last) != font(&first),
+    )
+}
+
+#[test]
+fn builders_take_more_styles_than_a_u16_indexes() {
+    let text = "a".repeat(MANY_STYLES as usize);
+    let mut fcx = create_font_context();
+    let mut lcx: LayoutContext<ColorBrush> = LayoutContext::new();
+    let root_style = create_root_style();
+    let last_brush = many_styles_brush(MANY_STYLES - 1);
+
+    let ranged = build_layout_with_ranged(
+        &mut fcx,
+        &mut lcx,
+        &RangedOptions {
+            scale: 1.,
+            quantize: false,
+            max_advance: Some(200.),
+            text: &text,
+        },
+        |rb| {
+            set_root_style(rb);
+            for i in 0..MANY_STYLES {
+                let i_usize = i as usize;
+                rb.push(
+                    StyleProperty::Brush(many_styles_brush(i)),
+                    i_usize..i_usize + 1,
+                );
+            }
+            let last = MANY_STYLES as usize - 1;
+            rb.push(FontFamily::from(MANY_STYLES_LAST_FAMILY), last..last + 1);
+        },
+    );
+    let (index, brush, other_font) = last_glyph_run_style(&ranged);
+    assert!(index > u32::from(u16::MAX), "{index}");
+    assert_eq!(brush, last_brush);
+    assert!(other_font);
+
+    let tree = build_layout_with_tree(
+        &mut fcx,
+        &mut lcx,
+        &TreeOptions {
+            scale: 1.,
+            quantize: false,
+            max_advance: Some(200.),
+            root_style: &root_style,
+        },
+        |tb| {
+            for i in 0..MANY_STYLES - 1 {
+                tb.push_style_modification_span(&[StyleProperty::Brush(many_styles_brush(i))]);
+                tb.push_text("a");
+                tb.pop_style_span();
+            }
+            tb.push_style_modification_span(&[
+                StyleProperty::Brush(last_brush),
+                StyleProperty::FontFamily(FontFamily::from(MANY_STYLES_LAST_FAMILY)),
+            ]);
+            tb.push_text("a");
+            tb.pop_style_span();
+        },
+    );
+    let (index, brush, other_font) = last_glyph_run_style(&tree);
+    assert!(index > u32::from(u16::MAX), "{index}");
+    assert_eq!(brush, last_brush);
+    assert!(other_font);
+
+    let runs = build_layout_with_style_runs(
+        &mut fcx,
+        &mut lcx,
+        &RangedOptions {
+            scale: 1.,
+            quantize: false,
+            max_advance: Some(200.),
+            text: &text,
+        },
+        |rb| {
+            for i in 0..MANY_STYLES {
+                let font_family = if i == MANY_STYLES - 1 {
+                    FontFamily::from(MANY_STYLES_LAST_FAMILY)
+                } else {
+                    root_style.font_family.clone()
+                };
+                let style = rb.push_style(TextStyle {
+                    brush: many_styles_brush(i),
+                    font_family,
+                    ..root_style.clone()
+                });
+                assert_eq!(style, i);
+                let i_usize = i as usize;
+                rb.push_style_run(style, i_usize..i_usize + 1);
+            }
+        },
+    );
+    let (index, brush, other_font) = last_glyph_run_style(&runs);
+    assert_eq!(index, MANY_STYLES - 1);
+    assert_eq!(brush, last_brush);
+    assert!(other_font);
+}
