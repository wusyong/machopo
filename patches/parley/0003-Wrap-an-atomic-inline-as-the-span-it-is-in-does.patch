From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Wu <yuweiwu@pm.me>
Date: Tue, 13 Oct 2026 17:11:34 +0900
Subject: [PATCH] Wrap an atomic inline as the span it is in does

The line breaker and the min/max-content measurer only set the current
text-wrap-mode from text, so an inline box first on a line used the
default, Wrap: in a nowrap span the line broke after it. An Auto box now
takes its parent style's mode before its opportunities are decided. An
inline's edge (KeepWithNext, KeepWithPrevious) doesn't: the opportunity
next to it belongs to the content beside it.
---
 README.kun.md                   |  1 +
 parley/src/layout/data.rs       | 10 +++++++++-
 parley/src/layout/line_break.rs | 10 ++++++++++
 3 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/README.kun.md b/README.kun.md
index 0c729ac396aedfa639f26724406959c954845d26..a05fa12fd479e0cde6f8fd6f678f41b05d197244 100644
--- a/README.kun.md
+++ b/README.kun.md
@@ -36,6 +36,7 @@ The commits on `kun` after upstream's:
 | --- | --- |
 | Add InlineBox::line_break | `InlineBox::line_break` (`InlineBoxLineBreak`): `Auto` is upstream's behaviour (a soft wrap opportunity on each side of the box); `KeepWithNext` and `KeepWithPrevious` give the box no opportunity of its own and keep it on the line of the content after or before it. For `KeepWithNext`, an opportunity right before that content is taken before the box instead. Both the line breaker and the min/max-content measurer follow this. |
 | Don't let inline box edges size the line | A `KeepWithNext` or `KeepWithPrevious` box (an inline's edge) takes up its width but adds nothing to the line's height, as an out-of-flow box doesn't. Upstream counts every in-flow box, so a 0px edge on the baseline made a line taller whenever the text's descent plus half-leading was negative (a `line-height` smaller than the font's), which WPT's `line-height-125` caught. |
+| Wrap an atomic inline as the span it is in does | The line breaker and the min/max-content measurer only set the current `text-wrap-mode` from text, so an inline box first on a line (or in a layout) used the default, `Wrap`: in a `nowrap` span the line broke after it (WPT's `css/css-overflow/text-overflow-009.html`). An `Auto` box now takes the mode of its parent style (`parent_style_index`) before its opportunities are decided. A `KeepWithNext` or `KeepWithPrevious` box (an inline's edge) doesn't: the opportunity next to it belongs to the content beside it (WPT's `css/CSS2/linebox/inline-formatting-context-012.xht`). Marked `kun:` in `layout/line_break.rs` and `layout/data.rs`. |
 | Add README.kun.md | This file. |
 
 Their tests are in kun: `cargo test -p layout --test it parley_inline_box::`.
diff --git a/parley/src/layout/data.rs b/parley/src/layout/data.rs
index 13a41d63358a3665e6c5ab4a66f3bc1127c2d92b..4706e20de694216043d82c71797e791fb8a5f12c 100644
--- a/parley/src/layout/data.rs
+++ b/parley/src/layout/data.rs
@@ -463,10 +463,18 @@ impl ContentWidthsMeasurer {
                     }
                 }
                 LayoutItemKind::InlineBox => {
-                    let inline_box = &layout_data.inline_boxes[item.index].inline_box;
+                    let layout_box = &layout_data.inline_boxes[item.index];
+                    let inline_box = &layout_box.inline_box;
                     let opportunity_after = inline_box.line_break
                         == InlineBoxLineBreak::KeepWithNext
                         && layout_data.soft_wrap_opportunity_after_box(item_idx);
+                    // kun: an atomic inline wraps as the span it is in does (as in the line
+                    // breaker).
+                    if inline_box.line_break == InlineBoxLineBreak::Auto {
+                        self.text_wrap_mode = layout_data.styles
+                            [usize::from(layout_box.parent_style_index)]
+                        .text_wrap_mode;
+                    }
                     self.measure_inline_box(inline_box, opportunity_after);
                 }
             }
diff --git a/parley/src/layout/line_break.rs b/parley/src/layout/line_break.rs
index 6c9d50e20dfdf9930d67318b5603bc67f172b505..2fb3d9e16b2ad406a0110838542c4af0cc7654ac 100644
--- a/parley/src/layout/line_break.rs
+++ b/parley/src/layout/line_break.rs
@@ -969,6 +969,16 @@ impl<'a, B: Brush> BreakLines<'a, B> {
                     };
 
                     let line_break = inline_box.line_break;
+                    // kun: an atomic inline wraps as the span it is in does. The mode is
+                    // otherwise only set by text, so one first on a line in a `nowrap` span took
+                    // the default (`Wrap`) and broke the line after it. An edge (kept with the
+                    // content next to it) has no opportunity of its own: the one next to it is
+                    // the content's, so it leaves the mode as the content has it.
+                    if line_break == InlineBoxLineBreak::Auto {
+                        let parent = self.layout.data.inline_boxes[item.index].parent_style_index;
+                        self.state.line.text_wrap_mode =
+                            self.layout.data.styles[usize::from(parent)].text_wrap_mode;
+                    }
                     let wraps = self.state.line.text_wrap_mode == TextWrapMode::Wrap;
 
                     // A box kept with the content after it takes that content's line-breaking
