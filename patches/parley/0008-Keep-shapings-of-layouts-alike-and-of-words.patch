+    let (byte_start, end) = (range.byte_range.start, range.clone());
+    let mut chars = text[range.byte_range.clone()]
+        .char_indices()
+        .map(move |(offset, ch)| (byte_start + offset, ch))
+        .zip(range.char_range.clone());
