diff --git a/parley/src/layout/layout.rs b/parley/src/layout/layout.rs
index 62af08e45f3d20de6bd3185cfc0a41ccd76ffb9c..09a149b4a8b67d94c2da4b76240b482915eb0c14 100644
--- a/parley/src/layout/layout.rs
+++ b/parley/src/layout/layout.rs
@@ -184,6 +184,18 @@ impl<B: Brush> Layout<B> {
         self.data.indent_options = options;
     }
 
+    /// kun: sets whether the line after a final forced break (a newline ending the text) is made.
+    ///
+    /// By default it is: an editor puts the caret there. CSS makes no line box after the last
+    /// forced break when nothing follows it (Blink's line breaker stops at the end of the
+    /// content), so `<div>a<br></div>` is one line tall; a text control keeps the line (Blink
+    /// adds a placeholder `<br>` to its value when it ends in a newline).
+    ///
+    /// This must be called before [`Layout::break_all_lines`] or [`Layout::break_lines`].
+    pub fn set_line_after_final_break(&mut self, made: bool) {
+        self.data.line_after_final_break = made;
+    }
+
     /// Returns line breaker to compute lines for the layout.
     pub fn break_lines(&mut self) -> BreakLines<'_, B> {
         BreakLines::new(self)
diff --git a/parley/src/layout/line_break.rs b/parley/src/layout/line_break.rs
index f26b93b4f19def2126f09dc9cb4fdccf0d71a950..f0e4be3df1e4369f1de4e6618055848446d24674 100644
--- a/parley/src/layout/line_break.rs
+++ b/parley/src/layout/line_break.rs
@@ -794,6 +794,18 @@ impl<'a, B: Brush> BreakLines<'a, B> {
             line_indent,
         );
 
+        // kun: a last line with no items after another is the line after a final forced break
+        // (the text ended with the break; see `finish_line`). Unless the layout makes it, it is
+        // taken back and nothing is yielded.
+        if reason == BreakReason::None
+            && !self.layout.data.line_after_final_break
+            && self.lines.lines.last().unwrap().item_range.is_empty()
+            && self.lines.lines.len() > 1
+        {
+            self.lines.lines.pop();
+            return None;
+        }
+
         // A line containing only empty inline boxes (and no text) is an invisible line box with
         // zero height; the strut only applies once the line has content. The trailing empty line
         // after a final newline has no items and keeps the strut so the cursor has a position.
