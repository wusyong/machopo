From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Wu Yuwei <yuweiwu@pm.me>
Date: Tue, 10 Nov 2026 14:00:52 +0900
Subject: [PATCH] Set a property of a tree builder's root style

`TreeBuilder::push_default` applies a property to the root style, as
`RangedBuilder::push_default` does for a ranged layout. It is for a
property the root `TextStyle` can't hold: `StyleProperty::FontFamilyIds`
has no field there, and a span around all the text isn't the same thing,
since the root style is also the style of a layout with no text and of a
line with nothing on it.

It must be called before anything is pushed: the spans and runs pushed
since would keep the style the root had, so it panics instead.

Tests: `test_tree_default` compares layouts with a default set against
ones whose root style holds the value (text, no text, and a trailing
empty line), with a font size and with family ids, checks that spans
inherit it, and that it panics after text, inside a span, and after
white space that is waiting to collapse.
---
 parley/src/builder.rs                 |  16 +++
 parley/src/resolve/tree.rs            |  11 ++
 parley/src/tests/mod.rs               |   1 +
 parley/src/tests/test_tree_default.rs | 175 ++++++++++++++++++++++++++
 4 files changed, 203 insertions(+)
 create mode 100644 parley/src/tests/test_tree_default.rs

diff --git a/parley/src/builder.rs b/parley/src/builder.rs
index d1ebd19b5966345bef4d2317d48d189d62107f95..7951aab52f59d2692d1e5ee296758f76ba8a84e0 100644
--- a/parley/src/builder.rs
+++ b/parley/src/builder.rs
@@ -278,6 +278,22 @@ pub struct TreeBuilder<'a, B: Brush> {
 }
 
 impl<'b, B: Brush> TreeBuilder<'b, B> {
+    /// machopo: sets a property of the root style, as [`RangedBuilder::push_default`] does
+    /// for a ranged layout: for a property the root [`TextStyle`] can't hold, such as
+    /// [`StyleProperty::FontFamilyIds`]. The root style is also that of a layout with no text
+    /// and of a line with nothing on it, which a span around the text doesn't reach.
+    ///
+    /// # Panics
+    ///
+    /// Panics if a span, text or an inline box has been pushed.
+    pub fn push_default<'a>(&mut self, property: impl Into<StyleProperty<'a, B>>) {
+        let resolved =
+            self.lcx
+                .rcx
+                .resolve_property(self.fcx, &property.into(), self.options.scale);
+        self.lcx.tree_style_builder.push_default(resolved);
+    }
+
     pub fn push_style_span(&mut self, style: TextStyle<'_, '_, B>) {
         let resolved = self
             .lcx
diff --git a/parley/src/resolve/tree.rs b/parley/src/resolve/tree.rs
index 00b88e4e4cd86ffbed21be7db99b39c7adb1b9a0..ea1b1d69717288f9433646d76f2de6f3c12fa5d9 100644
--- a/parley/src/resolve/tree.rs
+++ b/parley/src/resolve/tree.rs
@@ -92,6 +92,17 @@ impl<B: Brush> TreeStyleBuilder<B> {
         self.current_span = 0;
     }
 
+    /// machopo: applies `property` to the root style, which nothing may have been pushed
+    /// under yet: the spans and runs pushed since would keep the style it was.
+    pub(crate) fn push_default(&mut self, property: ResolvedProperty<B>) {
+        assert!(
+            self.tree.len() == 1 && self.text.is_empty() && self.pending_whitespace.is_none(),
+            "the root style is set before anything is pushed"
+        );
+        self.tree[0].style.apply(property);
+        self.style_table[0] = self.tree[0].style.clone();
+    }
+
     /// Appends a U+FFFC OBJECT REPLACEMENT CHARACTER representing an
     /// [`crate::InlineBoxKind::InFlow`] to the current span.
     ///
