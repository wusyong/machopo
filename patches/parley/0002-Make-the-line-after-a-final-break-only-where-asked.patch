diff --git a/parley/src/tests/test_final_break.rs b/parley/src/tests/test_final_break.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f8eb2aa5fd30261c6963ffd4c0b7e0ae20a10d5e
