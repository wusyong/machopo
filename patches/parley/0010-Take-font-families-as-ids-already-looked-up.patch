@@ -250,6 +250,12 @@ impl VerticalAlign {
 pub enum StyleProperty<'a, B: Brush> {
     /// CSS `font-family` property value.
     FontFamily(FontFamily<'a>),
+    /// machopo: the font families of a `font-family` value the caller has already looked up
