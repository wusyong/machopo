index a5540fd..28226b1 100644
--- a/crates/bindings/src/v8_text.rs
+++ b/crates/bindings/src/v8_text.rs
@@ -172,3 +172,24 @@ pub fn borrowed_texts() -> usize {
 pub fn ascii_scans_for_testing() -> Option<u64> {
     cfg!(debug_assertions).then(|| ASCII_SCANS.get())
 }
+
+/// PROTOTYPE (measured, not to be merged): `value` as a string if it is
+/// one already, read from its map as V8's header does (`IsString`), with
+/// no call into V8 and no context found; `None` for anything else, which
+/// WebIDL's `ToString` converts.
+#[inline(always)]
+pub fn string_if_string<'s>(value: v8::Local<'s, v8::Value>) -> Option<v8::Local<'s, v8::String>> {
+    // SAFETY (prototype): a handle's location holds its value's tagged
+    // address; a heap object's (low bit set) map is in its cage, whose
+    // instance type says whether it is a string (below 0x80).
+    unsafe {
+        let object = *std::ptr::from_ref::<v8::Value>(&value).cast::<usize>();
+        if object & 1 == 0 {
+            return None;
+        }
+        let cage = object & !((1usize << 32) - 1);
+        let map = cage + ((object - 1) as *const u32).read() as usize;
+        let instance_type = ((map - 1 + 8) as *const u16).read();
+        (instance_type < 0x80).then(|| v8::Local::cast_unchecked(value))
+    }
+}
