+/// PROTOTYPE (measured, not to be kept): `unwrap_receiver` with no tag
+/// compared and no null check.
+#[cfg(not(feature = "v8_enable_sandbox"))]
+#[inline(always)]
+pub unsafe fn unwrap_receiver_unchecked(
+  isolate: &mut Isolate,
+  wrapper: Local<Object>,
+) -> NonNull<c_void> {
+  unsafe {
+    let object = *(&*wrapper as *const Object).cast::<usize>();
+    let handle =
+      ((object - HEAP_OBJECT_TAG + JS_OBJECT_HEADER_SIZE) as *const u32).read();
+    let table = *(isolate.as_real_ptr() as *const u8)
+      .add(CPP_HEAP_POINTER_TABLE_OFFSET)
+      .cast::<*const std::sync::atomic::AtomicUsize>();
+    let entry = (*table.add((handle >> INDEX_SHIFT) as usize))
+      .load(std::sync::atomic::Ordering::Relaxed);
+    NonNull::new_unchecked((entry >> PAYLOAD_SHIFT) as *mut c_void)
+  }
+}
+
