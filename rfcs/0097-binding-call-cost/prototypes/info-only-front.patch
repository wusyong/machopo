+pub(crate) fn report_these(
+    scope: &mut Scope<'_, '_, '_>,
+    microtasks: dom::Microtasks,
+    used: Option<usize>,
+) {
     if !microtasks.is_empty() {
         queue_microtasks(scope, microtasks);
     }
