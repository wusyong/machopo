+impl<M: TypedMember> bindings::RawMethod<State> for RawMember<M> {
+    fn call(info: bindings::StateInfo<'_, State>) {
+        let mut front = crate::front::RawFront::new(info);
+        M::call(&mut front);
+        if M::KIND != MemberKind::Getter {
+            front.report();
+        }
+    }
+}
