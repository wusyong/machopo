diff --git a/crates/dom_js/src/front.rs b/crates/dom_js/src/front.rs
index bbaa4ee..fc542c5 100644
--- a/crates/dom_js/src/front.rs
+++ b/crates/dom_js/src/front.rs
@@ -3992,3 +3992,277 @@ fn radius<'s>(scope: &mut v8::PinScope<'s, '_>, value: v8::Local<'s, v8::Value>)
         y: point[1],
