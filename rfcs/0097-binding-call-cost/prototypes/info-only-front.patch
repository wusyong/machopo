+#[test]
+fn prototype_raw_members() {
+    let mut env = Env::new();
+    env.eval(
+        "var d = machopoDom.createDocument(); var n = d.createElement('body'); d.appendChild(n); \
+         var p = d.createElement('p'); n.setAttribute('id', 'x');",
+    );
+    for (source, expected) in [
+        ("n.nodeTypeRaw", "1"),
+        ("n.firstChildRaw", "null"),
+        ("n.appendChildRaw(p) === p", "true"),
+        ("n.firstChildRaw === p", "true"),
+        ("n.getAttributeRaw('id')", "x"),
+        ("n.getAttributeRaw('nope')", "null"),
+        ("n.hasAttributeRaw('id')", "true"),
+        ("n.setAttributeRaw('a', 'b'); n.getAttribute('a')", "b"),
+        ("n.setAttributeRaw('data-new', 'new-value-' + 1); n.getAttributeRaw('data-new')", "new-value-1"),
+        ("n.getAttributeRaw(7)", "null"),
+        ("try { n.getAttributeRaw(); 'none' } catch (e) { e.name }", "TypeError"),
+        ("try { n.setAttributeRaw('a b', 'c'); 'none' } catch (e) { e.name }", "InvalidCharacterError"),
+        ("try { n.appendChildRaw(n); 'none' } catch (e) { e.name }", "HierarchyRequestError"),
+        ("try { n.appendChildRaw(1); 'none' } catch (e) { e.name }", "TypeError"),
+        ("d.createElement('div').appendChildRaw(d.createElement('i')).nodeTypeRaw", "1"),
+        ("n.innerHTML = '<b></b>'; n.firstChildRaw.tagName", "B"),
