+
+// PROTOTYPE (measured, not to be merged): a function callback given V8's
+// `FunctionCallbackInfo` alone, as Blink's generated callbacks are: the
+// isolate, the receiver, the arguments and the return value are read from
+// it; a scope is made only where one is asked for, and dropped there.
+
+/// A function callback's info, its isolate's state a `T`.
+pub struct StateInfo<'s, T> {
+    info: &'s v8::FunctionCallbackInfo,
+    _state: PhantomData<fn() -> T>,
+}
+
+/// What a holder of the state may ask of V8 with the isolate alone.
+pub struct RawNoGc<'b> {
+    isolate: &'b mut v8::Isolate,
+}
+
+impl<'s, T: Any> StateInfo<'s, T> {
+    #[inline(always)]
+    pub fn isolate(&mut self) -> &mut v8::Isolate {
+        // SAFETY (prototype): the frame's slot holding the isolate's
+        // pointer, valid for the callback; borrowed as `self` is.
+        unsafe { &mut *self.info.isolate().as_ptr() }
+    }
+
+    #[inline(always)]
+    pub fn args(&self) -> v8::FunctionCallbackArguments<'s> {
+        v8::FunctionCallbackArguments::from_function_callback_info(self.info)
+    }
+
+    #[inline(always)]
+    pub fn rv(&self) -> v8::ReturnValue<'s, v8::Value> {
+        v8::ReturnValue::from_function_callback_info(self.info)
+    }
+
+    /// The receiver, which V8 checked against the function's signature.
+    #[inline(always)]
+    pub fn receiver(&self) -> Receiver<'s> {
+        Receiver(self.args().this())
+    }
+
+    #[inline(always)]
+    pub fn state(&mut self) -> (&T, RawNoGc<'_>) {
+        let isolate = self.isolate();
+        // SAFETY (prototype): as `StateScope::state`.
+        let state = unsafe { unchecked::<T>(isolate).as_ref() };
+        (state, RawNoGc { isolate })
+    }
+
+    #[inline(always)]
+    pub fn state_mut(&mut self) -> (&mut T, RawNoGc<'_>) {
+        let isolate = self.isolate();
+        // SAFETY (prototype): as `StateScope::state_mut`.
+        let state = unsafe { unchecked::<T>(isolate).as_mut() };
+        (state, RawNoGc { isolate })
+    }
+
+    /// `f` of a scope made now (rusty_v8's `CallbackScope` of the info),
+    /// dropped as `f` returns: for what allocates, throws or runs script.
+    #[inline(never)]
+    pub fn with_scope<R>(&mut self, f: impl FnOnce(StateScope<'_, 's, 's, T>) -> R) -> R {
+        // SAFETY (prototype): V8's callback info, as rusty_v8's own
+        // trampoline makes a scope of.
+        v8::callback_scope!(unsafe scope, self.info);
+        f(StateScope {
+            scope,
+            _state: PhantomData,
+        })
+    }
+}
+
+impl RawNoGc<'_> {
+    #[inline(always)]
+    pub fn isolate(&mut self) -> &mut v8::Isolate {
+        self.isolate
+    }
+
+    #[inline(always)]
+    pub fn unwrap<'gc, O: elise::HeapType>(
+        &mut self,
+        cx: &elise::Mutation<'gc>,
+        object: v8::Local<'_, v8::Object>,
+    ) -> Option<elise::Gc<'gc, O>> {
+        crate::unified_heap::unwrap_object(self.isolate, cx, object)
+    }
+
+    #[inline(always)]
+    pub fn unwrap_receiver<'gc, O: elise::HeapType>(
+        &mut self,
+        cx: &elise::Mutation<'gc>,
+        this: Receiver<'_>,
+    ) -> Option<elise::Gc<'gc, O>> {
+        crate::unified_heap::unwrap_receiver(self.isolate, cx, this)
+    }
+
+    #[inline(always)]
+    pub fn return_wrapper(
+        &mut self,
+        rv: &mut v8::ReturnValue<'_, v8::Value>,
+        edge: &elise::JsEdge,
+    ) -> bool {
+        crate::unified_heap::return_wrapper_raw(self.isolate, rv, edge)
+    }
+
+    #[inline(always)]
+    pub fn return_weak<S>(
+        &mut self,
+        rv: &mut v8::ReturnValue<'_, v8::Value>,
+        weak: &v8::Weak<S>,
+    ) -> bool
+    where
+        for<'a> v8::Local<'a, S>: Into<v8::Local<'a, v8::Value>>,
+    {
+        rv.set_weak(self.isolate, weak)
+    }
+
+    #[inline(always)]
+    pub fn ascii<'a>(&mut self, string: &'a crate::LentString<'_>) -> Option<&'a str> {
+        string.ascii(self.isolate)
+    }
+}
+
+/// A method given its callback's info alone.
+pub trait RawMethod<T>: 'static {
+    fn call(info: StateInfo<'_, T>);
+}
+
+unsafe extern "C" fn raw_method_trampoline<T: Any, C: RawMethod<T>>(
+    info: *const v8::FunctionCallbackInfo,
+) {
+    // SAFETY (prototype): V8's callback info, valid for the call.
+    C::call(StateInfo {
+        info: unsafe { &*info },
+        _state: PhantomData,
+    });
+}
+
+/// A function template whose callback is `C`'s, its receiver checked
+/// against `signature`.
+pub fn raw_method_template<'s, T: Any, C: RawMethod<T>>(
+    scope: &mut v8::PinScope<'s, '_>,
+    signature: v8::Local<'s, v8::Signature>,
+    length: i32,
+) -> v8::Local<'s, v8::FunctionTemplate> {
+    assert!(checked::<T>(scope).is_some());
+    v8::FunctionTemplate::builder_raw(raw_method_trampoline::<T, C>)
+        .signature(signature)
+        .length(length)
+        .constructor_behavior(v8::ConstructorBehavior::Throw)
+        .build(scope)
+}
