+
+// PROTOTYPE (measured, not to be merged): a front end that is the
+// callback's info and one result left for after the operation, for the
+// members whose arguments are strings and nodes and whose results are
+// numbers, booleans, strings and nodes. What allocates, throws or runs
+// script makes a scope and a `V8Front` then, out of line.
+
+pub(crate) struct RawFront<'s> {
+    info: bindings::StateInfo<'s, State>,
+    pending: Option<Kept>,
+}
+
+pub(crate) struct RawOp<'o, 's> {
+    no_gc: bindings::RawNoGc<'o>,
+    this: bindings::Receiver<'s>,
+    rv: v8::ReturnValue<'s, v8::Value>,
+    pending: &'o mut Option<Kept>,
+    caches: &'o Caches,
+}
+
+impl<'s> FrontTypes for RawFront<'s> {
+    type Str = ArgString<'s>;
+    type Node = v8::Local<'s, v8::Object>;
+    type Dict = v8::Local<'s, v8::Object>;
+}
+
+impl<'s> FrontTypes for RawOp<'_, 's> {
+    type Str = ArgString<'s>;
+    type Node = v8::Local<'s, v8::Object>;
+    type Dict = v8::Local<'s, v8::Object>;
+}
+
+impl<'s> RawFront<'s> {
+    #[inline(always)]
+    pub(crate) fn new(info: bindings::StateInfo<'s, State>) -> Self {
+        Self {
+            info,
+            pending: None,
+        }
+    }
+
+    /// `f` of the whole front end, a scope made for it: the slow paths.
+    #[cold]
+    #[inline(never)]
+    fn with_front<R>(
+        &mut self,
+        f: impl FnOnce(&mut V8Front<'_, 's, 's, 's, Checked<'s>>) -> R,
+    ) -> R {
+        let args = Checked {
+            args: self.info.args(),
+            this: self.info.receiver(),
+        };
+        let rv = self.info.rv();
+        self.info.with_scope(|scope| f(&mut V8Front::new(scope, &args, rv)))
+    }
+
+    #[cold]
+    #[inline(never)]
+    fn slow_string_arg(&mut self, value: v8::Local<'s, v8::Value>) -> Option<ArgString<'s>> {
+        self.info
+            .with_scope(|mut scope| strings::arg_string(scope.scope(), value))
+    }
+
+    /// As `state::report`, the scope made only if V8 is told something.
+    #[inline(always)]
+    pub(crate) fn report(&mut self) {
+        let (microtasks, moved) = {
+            let (state, _) = self.info.state_mut();
+            (state.dom.take_microtasks(), state::moved(state))
+        };
+        if !microtasks.is_empty() || moved.is_some() {
+            self.report_slow(microtasks, moved);
+        }
+    }
+
+    #[cold]
+    #[inline(never)]
+    fn report_slow(&mut self, microtasks: dom::Microtasks, used: Option<usize>) {
+        self.info
+            .with_scope(|mut scope| state::report_these(&mut scope, microtasks, used));
+    }
+}
+
+impl<'s> Front for RawFront<'s> {
+    type Op<'o>
+        = RawOp<'o, 's>
+    where
+        Self: 'o;
+
+    #[inline(always)]
+    fn read<'o, R>(
+        &'o mut self,
+        f: impl for<'gc> FnOnce(&ApiCx<'_, 'gc>, &mut Self::Op<'o>) -> R,
+    ) -> R {
+        let (this, rv) = (self.info.receiver(), self.info.rv());
+        let (state, no_gc) = self.info.state();
+        let mut op = RawOp {
+            no_gc,
+            this,
+            rv,
+            pending: &mut self.pending,
+            caches: &state.caches,
+        };
+        state
+            .dom
+            .read(|cx| f(&ApiCx::with_layout_cell(cx, &state.layout), &mut op))
+    }
+
+    #[inline(always)]
+    fn mutate<'o, R>(
+        &'o mut self,
+        f: impl for<'gc> FnOnce(&ApiCx<'_, 'gc>, &mut Self::Op<'o>) -> R,
+    ) -> R {
+        let (this, rv) = (self.info.receiver(), self.info.rv());
+        let (state, no_gc) = self.info.state_mut();
+        let State {
+            dom,
+            caches,
+            layout,
+            ..
+        } = state;
+        let mut op = RawOp {
+            no_gc,
+            this,
+            rv,
+            pending: &mut self.pending,
+            caches,
+        };
+        dom.mutate(|cx| f(&ApiCx::with_layout_cell(cx, layout), &mut op))
+    }
+
+    #[inline(always)]
+    fn has_args(&mut self, name: &str, required: usize) -> bool {
+        let given = usize::try_from(self.info.args().length()).unwrap_or(0);
+        if given >= required {
+            return true;
+        }
+        self.with_front(|front| front.has_args(name, required))
+    }
+
+    #[inline(always)]
+    fn string_arg(&mut self, index: usize) -> Option<ArgString<'s>> {
+        let value = arg(&self.info.args(), index);
+        if let Some(string) = v8::machopo::as_string(value) {
+            let string = bindings::LentString::new(string);
+            if string.lends(self.info.isolate()) {
+                return Some(ArgString::lent(string));
+            }
+        }
+        self.slow_string_arg(value)
+    }
+
+    fn nullable_string_arg(&mut self, index: usize) -> Option<Option<ArgString<'s>>> {
+        let value = arg(&self.info.args(), index);
+        if value.is_null_or_undefined() {
+            return Some(None);
+        }
+        self.string_arg(index).map(Some)
+    }
+
+    fn legacy_null_string_arg(&mut self, index: usize) -> Option<Option<ArgString<'s>>> {
+        let value = arg(&self.info.args(), index);
+        if value.is_null() {
+            return Some(None);
+        }
+        self.string_arg(index).map(Some)
+    }
+
+    #[inline(always)]
+    fn node_arg(&mut self, index: usize) -> Option<Option<v8::Local<'s, v8::Object>>> {
+        let value = arg(&self.info.args(), index);
+        if value.is_null_or_undefined() {
+            return Some(None);
+        }
+        if bindings::is_wrapper::<Node>(self.info.isolate(), value) {
+            return v8::Local::<v8::Object>::try_from(value).ok().map(Some);
+        }
+        self.with_front(|front| front.node_arg(index))
+    }
+
+    #[inline(always)]
+    fn finish(&mut self) {
+        if self.pending.is_some() {
+            let kept = self.pending.take();
+            self.with_front(|front| {
+                *front.call.kept = kept.map(Box::new);
+                front.finish();
+            });
+        }
+    }
+
+    #[cold]
+    #[inline(never)]
+    fn throw(&mut self, error: ApiError) {
+        self.with_front(|front| front.throw(error));
+    }
+
+    fn update_elements(&mut self) {
+        self.with_front(|front| front.update_elements());
+    }
+}
+
+impl<'s> OpFront for RawOp<'_, 's> {
+    #[inline(always)]
+    fn str_param<'a>(&mut self, string: &'a ArgString<'s>) -> &'a str {
+        string.text_raw(&mut self.no_gc)
+    }
+
+    #[inline(always)]
+    fn this_as<'gc, T: elise::HeapType>(
+        &mut self,
+        cx: &ApiCx<'_, 'gc>,
+    ) -> Option<elise::Gc<'gc, T>> {
+        self.no_gc.unwrap_receiver::<T>(cx.gc, self.this)
+    }
+
+    #[inline(always)]
+    fn node<'gc>(&mut self, cx: &ApiCx<'_, 'gc>, node: &v8::Local<'s, v8::Object>) -> NodeRef<'gc> {
+        self.no_gc
+            .unwrap::<Node>(cx.gc, *node)
+            .expect("a wrapper, checked as it was taken")
+    }
+
+    fn ret_undefined(&mut self) {}
+
+    #[inline(always)]
+    fn ret_null(&mut self) {
+        bindings::OpReturn::new(&mut self.rv).set_null();
+    }
+
+    #[inline(always)]
+    fn ret_bool(&mut self, value: bool) {
+        bindings::OpReturn::new(&mut self.rv).set_bool(value);
+    }
+
+    #[inline(always)]
+    fn ret_u32(&mut self, value: u32) {
+        if !bindings::OpReturn::new(&mut self.rv).set_smi_u32(value) {
+            *self.pending = Some(Kept::U32(value));
+        }
+    }
+
+    #[inline(always)]
+    fn ret_f64(&mut self, value: f64) {
+        let integer = value.fract() == 0.0
+            && value.abs() <= f64::from(i32::MAX)
+            && !(value == 0.0 && value.is_sign_negative());
+        if !(integer
+            && bindings::OpReturn::new(&mut self.rv)
+                .set_smi_i32(base::numerics::saturated_cast::<i32, f64>(value)))
+        {
+            *self.pending = Some(Kept::F64(value));
+        }
+    }
+
+    #[inline(always)]
+    fn ret_string(&mut self, value: &DomString) {
+        let returned = self
+            .caches
+            .strings
+            .find(value)
+            .is_some_and(|weak| self.no_gc.return_weak(&mut self.rv, weak));
+        if !returned {
+            *self.pending = Some(Kept::String(value.clone()));
+        }
+    }
+
+    #[inline(always)]
+    fn ret_node<'gc>(&mut self, cx: &ApiCx<'_, 'gc>, node: NodeRef<'gc>) {
+        if !self.no_gc.return_wrapper(&mut self.rv, cx.wrapper_edge(node)) {
+            *self.pending = Some(Kept::Node(cx.root(node), interface_of(cx, node)));
+        }
+    }
+}
