index d0b1309..56f2bc7 100644
--- a/crates/bindings/src/isolate_state.rs
+++ b/crates/bindings/src/isolate_state.rs
@@ -997,3 +997,54 @@ pub fn set_state_refused_access<T: Any, A: StateAccessCheck<T>>(isolate: &mut v8
     );
     isolate.set_failed_access_check_callback_function(refused_access::<T, A>);
 }
+
+// PROTOTYPE (measured, not to be merged): a getter called with
+// V8's `FunctionCallbackInfo` itself, no `CallbackScope` made, to measure
+// what the scope and the front end's call structure cost.
+
+/// A getter given the isolate's state, the isolate, its receiver (checked
+/// against the function's signature) and where its result goes.
+pub trait RawGetter<T>: 'static {
+    fn get<'s>(
+        state: &T,
+        isolate: &mut v8::Isolate,
+        this: Receiver<'s>,
+        rv: &mut v8::ReturnValue<'s, v8::Value>,
+    );
+}
+
+unsafe extern "C" fn raw_getter_trampoline<T: Any, C: RawGetter<T>>(
+    info: *const v8::FunctionCallbackInfo,
+) {
+    // SAFETY (prototype): V8's callback info, valid for the call; the
+    // receiver V8 checked against the signature; the isolate's state is a
+    // `T` (`raw_getter_template` checked).
+    unsafe {
+        let info = &*info;
+        let args = v8::FunctionCallbackArguments::from_function_callback_info(info);
+        let mut rv = v8::ReturnValue::from_function_callback_info(info);
+        let this = Receiver(args.this());
+        // The isolate's slot of the callback's frame (the fork's
+        // `frame::ISOLATE`): `v8::Isolate` is that pointer, transparent.
+        // rusty_v8's `FunctionCallbackArguments::get_isolate` casts the
+        // pointer to a `*mut Isolate` instead, and crashes.
+        let raw = *(std::ptr::from_ref(info).cast::<usize>()).offset(5);
+        let mut isolate =
+            std::mem::ManuallyDrop::new(std::mem::transmute::<usize, v8::Isolate>(raw));
+        let state = unchecked::<T>(&isolate).as_ref();
+        C::get(state, &mut isolate, this, &mut rv);
+    }
+}
+
+/// A getter's function template whose callback is `C`'s raw one.
+pub fn raw_getter_template<'s, T: Any, C: RawGetter<T>>(
+    scope: &mut v8::PinScope<'s, '_>,
+    signature: v8::Local<'s, v8::Signature>,
+) -> v8::Local<'s, v8::FunctionTemplate> {
+    assert!(checked::<T>(scope).is_some());
+    v8::FunctionTemplate::builder_raw(raw_getter_trampoline::<T, C>)
+        .signature(signature)
+        .length(0)
+        .constructor_behavior(v8::ConstructorBehavior::Throw)
+        .build(scope)
+}
