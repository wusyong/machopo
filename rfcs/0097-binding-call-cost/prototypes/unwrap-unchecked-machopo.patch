+
+struct RawNodeTypeUnchecked;
+
+impl bindings::RawGetter<State> for RawNodeTypeUnchecked {
+    #[inline]
+    fn get<'s>(
+        state: &State,
+        isolate: &mut v8::Isolate,
+        this: bindings::Receiver<'s>,
+        rv: &mut v8::ReturnValue<'s, v8::Value>,
+    ) {
+        state.dom.read(|cx| {
+            let node = bindings::unwrap_receiver_unchecked_for_prototype::<dom::Node>(isolate, cx.gc, this);
+            rv.set_int32(i32::from(cx.node_type(node)));
+        });
+    }
+}
