+/// PROTOTYPE (measured, not to be merged): `unwrap_receiver` with no tag
+/// compared and no check of the cage.
+#[inline]
+pub unsafe fn unwrap_receiver_unchecked<'gc, T: elise::HeapType>(
+    isolate: &mut v8::Isolate,
+    cx: &elise::Mutation<'gc>,
+    this: crate::Receiver<'_>,
+) -> elise::Gc<'gc, T> {
+    unsafe {
+        let address = v8::machopo::unwrap_receiver_unchecked(isolate, this.object());
+        cx.from_engine_unchecked::<T>(address.cast())
+    }
+}
