+    // SAFETY (prototype): `text` lives for ever.
+    unsafe {
+        let Some(own) = v8::String::new_external_onebyte_raw(
+            scope,
+            text.as_ptr().cast_mut().cast(),
+            text.len(),
+            keep,
+        ) else {
+            return false;
+        };
