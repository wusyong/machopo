+) -> Option<v8::Local<'s, v8::String>> {
+    // SAFETY (prototype): the caller's text lives until `destructor`.
+    unsafe { v8::String::new_external_onebyte_raw(scope, text.cast_mut().cast(), len, destructor) }
+}
