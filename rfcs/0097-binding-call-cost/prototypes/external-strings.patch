+//! PROTOTYPE (measured, not to be merged): what an external string of V8
+//! could carry of the DOM's (Blink's `StringResourceBase`, which keeps
+//! the `AtomicString` of a string V8 made external).
+//!
+//! In: the texts V8's strings were made external with live in one arena,
+//! never freed, each after a header that remembers its name's number and
+//! its interned value, so that `names::find` and `intern_value` of such a
+//! text read the header (an address in the arena's range) and hash
+//! nothing. Out: a `DomString`'s text lent to V8 by its address, a count
+//! held until V8 frees it.
+#![allow(unsafe_code, reason = "a prototype")]
+
+use std::cell::{Cell, OnceCell};
+use std::ffi::c_char;
+use std::rc::Rc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use crate::DomString;
+
+/// What an external text remembers.
+pub(crate) struct Header {
+    /// Its name's number and one, or 0 before it is looked up.
+    pub(crate) name: Cell<u32>,
+    pub(crate) value: OnceCell<DomString>,
+}
+
+const ARENA_BYTES: usize = 1 << 20;
+const HEADER: usize = std::mem::size_of::<Header>();
+
+static BASE: AtomicUsize = AtomicUsize::new(0);
+static USED: AtomicUsize = AtomicUsize::new(0);
+
+/// A copy of `text` in the arena, after a new header; none once it is full.
+pub fn alloc(text: &str) -> Option<&'static str> {
+    let mut base = BASE.load(Ordering::Relaxed);
+    if base == 0 {
+        base = Vec::leak(vec![0u64; ARENA_BYTES / 8]).as_mut_ptr().addr();
+        BASE.store(base, Ordering::Relaxed);
+    }
+    let at = USED.load(Ordering::Relaxed).next_multiple_of(8);
+    let end = at.checked_add(HEADER)?.checked_add(text.len())?;
+    if end > ARENA_BYTES {
+        return None;
+    }
+    USED.store(end, Ordering::Relaxed);
+    // SAFETY (prototype): in the arena, aligned, written once here.
+    unsafe {
+        let header = (base + at) as *mut Header;
+        header.write(Header {
+            name: Cell::new(0),
+            value: OnceCell::new(),
+        });
+        let chars = (base + at + HEADER) as *mut u8;
+        std::ptr::copy_nonoverlapping(text.as_ptr(), chars, text.len());
+        Some(std::str::from_utf8_unchecked(std::slice::from_raw_parts(
+            chars,
+            text.len(),
+        )))
+    }
+}
+
+/// `text`'s header, if it is the arena's.
+#[inline(always)]
+pub(crate) fn header(text: &str) -> Option<&'static Header> {
+    let at = text.as_ptr().addr().wrapping_sub(BASE.load(Ordering::Relaxed));
+    // SAFETY (prototype): every text in the arena follows its header
+    // (texts are only read whole, as `alloc` gave them).
+    (at < ARENA_BYTES).then(|| unsafe { &*((text.as_ptr().addr() - HEADER) as *const Header) })
+}
+
+/// The texts V8 freed, by address and length, until the DOM's thread
+/// drops their counts: V8 frees an external string's buffer on its GC's
+/// workers, and a string's count isn't atomic.
+static FREED: std::sync::Mutex<Vec<(usize, usize)>> = std::sync::Mutex::new(Vec::new());
+static FREED_COUNT: AtomicUsize = AtomicUsize::new(0);
+
+/// `string`'s text's address and length, a count of it held until V8
+/// frees the string made of them (`drop_lent`). Drops the counts of those
+/// freed since.
+pub fn lend(string: &DomString) -> (*const u8, usize) {
+    if FREED_COUNT.load(Ordering::Relaxed) != 0 {
+        let freed = {
+            let mut freed = FREED.lock().unwrap();
+            FREED_COUNT.store(0, Ordering::Relaxed);
+            std::mem::take(&mut *freed)
+        };
+        for (text, len) in freed {
+            // SAFETY (prototype): `lend`'s address and length, once.
+            unsafe {
+                let text = std::ptr::slice_from_raw_parts(text as *const u8, len) as *const str;
+                drop(Rc::from_raw(text));
+            }
+        }
+    }
+    let text = Rc::into_raw(string.text_rc());
+    (text.cast::<u8>(), string.len())
+}
+
+/// V8's external string's destructor, on any thread: the text is the
+/// DOM's thread's to drop (`lend`).
+pub unsafe extern "C" fn drop_lent(text: *mut c_char, len: usize) {
+    let mut freed = FREED.lock().unwrap();
+    freed.push((text.addr(), len));
+    FREED_COUNT.store(freed.len(), Ordering::Relaxed);
+}
