+
+/// Lab: a JS document's `pagehide` and `unload` call `fetch()` as a wasm
+/// document replaces it, its engine with it; the wasm document loads.
+#[test]
+fn lab_a_fetch_in_unload_as_the_engine_changes() {
+    use std::collections::HashMap;
+
+    use net::test_server::{Route, TestServer, Unanswered};
+    let server = TestServer::start(HashMap::from([
+        (
+            "/js".to_owned(),
+            Route::ok(
+                "text/html",
+                "<!DOCTYPE html><title>js</title><script>onpagehide = () => fetch('/ping'); \
+                 onunload = () => fetch('/ping2'); location.href = '/wasm';</script><img src=/never>",
+            ),
+        ),
+        (
+            "/never".to_owned(),
+            Route::ok("image/png", "").unanswered(Unanswered::Never),
+        ),
+        (
+            "/wasm".to_owned(),
+            Route::ok("text/html", format!("<!DOCTYPE html>{META}<title>wasm</title>")),
+        ),
+        ("/ping".to_owned(), Route::ok("text/plain", "")),
+        ("/ping2".to_owned(), Route::ok("text/plain", "")),
+    ]))
+    .expect("the test server starts");
+    assert_eq!(render(&server.url("/js")).title.as_deref(), Some("wasm"));
+}
