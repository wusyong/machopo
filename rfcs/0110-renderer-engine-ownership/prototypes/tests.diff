+#[test]
+fn lab_a_busy_scripts_redirect_is_told() {
+    let server = server(&[
+        ("/", Route::ok("text/html", "<!DOCTYPE html>page")),
+        ("/moved", Route::redirect(302, "/plain")),
+        ("/plain", Route::ok("text/plain", "plain")),
+    ]);
+    let machopo = Machopo::start();
+    let (mut page, _) = page(&machopo);
+    load(&mut page, &server.url("/"));
+    page.call(None, "Network.enable", json!({}));
+    evaluate(&mut page, "fetch('/moved'); { const until = Date.now() + 200; while (Date.now() < until); } 0", None);
+    let events = network_events(&mut page, 1);
+    let sent = events.iter().filter(|e| e["method"] == "Network.requestWillBeSent").count();
+    assert_eq!(sent, 2, "redirect lost");
+}
+
+#[test]
+fn lab_a_busy_scripts_request_is_stamped_before_it_ends() {
+    let server = server(&[
+        ("/", Route::ok("text/html", "<!DOCTYPE html>page")),
+        ("/plain", Route::ok("text/plain", "plain")),
+    ]);
+    let machopo = Machopo::start();
+    let (mut page, _) = page(&machopo);
+    load(&mut page, &server.url("/"));
+    page.call(None, "Network.enable", json!({}));
+    evaluate(&mut page, "fetch('/plain'); { const until = Date.now() + 200; while (Date.now() < until); } 0", None);
+    let events = network_events(&mut page, 1);
+    let at = |method: &str| events.iter().find(|e| e["method"] == method).unwrap()["params"]["timestamp"].as_f64();
+    assert!(at("Network.loadingFinished") >= at("Network.requestWillBeSent"), "stamped late");
+}
+
 /// A redirect is another `requestWillBeSent` of the same request, with the
 /// redirect's response; a load that fails, and one cancelled, end in
 /// `loadingFailed`.
