diff --git a/crates/renderer/src/render_thread/engine_slot.rs b/crates/renderer/src/render_thread/engine_slot.rs
new file mode 100644
index 0000000..e0a8897
--- /dev/null
+++ b/crates/renderer/src/render_thread/engine_slot.rs
@@ -0,0 +1,115 @@
+//! The page's engine, and the render thread's requests (`LoadState`) that
+//! its load sink needs while script runs. The render thread owns them;
+//! reaching the engine through the slot (`as_mut`) lends them to the
+//! engine's load sink, and reaching them (`state_mut`) takes them back.
+//! Both borrow the whole slot, so the borrow checker keeps the render
+//! thread from holding the engine and its requests at once; and neither
+//! leaves a guard behind, so each borrow ends at its last use.
+
+use dom_api::ScriptEngine;
+
+use super::documents::RendererLoadSink;
+use crate::loader::LoadState;
+
+pub(super) struct EngineSlot {
+    engine: Option<Box<dyn ScriptEngine>>,
+    /// None while lent to the engine's sink.
+    state: Option<LoadState>,
+}
+
+impl Default for EngineSlot {
+    fn default() -> Self {
+        Self {
+            engine: None,
+            state: Some(LoadState::default()),
+        }
+    }
+}
+
+fn sink(engine: &mut Box<dyn ScriptEngine>) -> Option<&mut RendererLoadSink> {
+    engine
+        .load_sink_mut()?
+        .as_any_mut()
+        .downcast_mut::<RendererLoadSink>()
+}
+
+/// Puts `state` in `engine`'s sink, if it has one (the wasm engine
+/// keeps none): what it can't take stays in `state`.
+fn lend(engine: &mut Box<dyn ScriptEngine>, state: &mut Option<LoadState>) {
+    if let Some(sink) = sink(engine)
+        && let Some(lent) = state.take()
+    {
+        sink.lent = Some(lent);
+    }
+}
+
+/// Takes back what `lend` put in `engine`'s sink.
+fn take_back(engine: &mut Box<dyn ScriptEngine>, state: &mut Option<LoadState>) {
+    if let Some(sink) = sink(engine)
+        && let Some(lent) = sink.lent.take()
+    {
+        *state = Some(lent);
+    }
+}
+
+impl EngineSlot {
+    /// The engine, the requests lent to its sink.
+    pub(super) fn as_mut(&mut self) -> Option<&mut Box<dyn ScriptEngine>> {
+        let engine = self.engine.as_mut()?;
+        lend(engine, &mut self.state);
+        Some(engine)
+    }
+
+    pub(super) fn as_ref(&self) -> Option<&Box<dyn ScriptEngine>> {
+        self.engine.as_ref()
+    }
+
+    /// The engine without lending it the requests: for reading and
+    /// writing the DOM and the layout, which runs no script.
+    pub(super) fn unlent_mut(&mut self) -> Option<&mut Box<dyn ScriptEngine>> {
+        self.engine.as_mut()
+    }
+
+    pub(super) fn is_some(&self) -> bool {
+        self.engine.is_some()
+    }
+
+    pub(super) fn is_none(&self) -> bool {
+        self.engine.is_none()
+    }
+
+    /// The engine, taken (to a parser, which runs script with it): the
+    /// requests go with it, in its sink, until it is `put` back.
+    pub(super) fn take(&mut self) -> Option<Box<dyn ScriptEngine>> {
+        let mut engine = self.engine.take()?;
+        lend(&mut engine, &mut self.state);
+        Some(engine)
+    }
+
+    /// The engine, taken to be dropped: the requests stay.
+    pub(super) fn take_to_drop(&mut self) -> Option<Box<dyn ScriptEngine>> {
+        let mut engine = self.engine.take()?;
+        take_back(&mut engine, &mut self.state);
+        Some(engine)
+    }
+
+    /// `engine` in the slot (with the requests, if it has them).
+    pub(super) fn put(&mut self, engine: Box<dyn ScriptEngine>) {
+        self.engine = Some(engine);
+    }
+
+    /// The requests, taken back from the engine's sink. None while the
+    /// engine is taken (`take`).
+    pub(super) fn state(&mut self) -> Option<&mut LoadState> {
+        if let Some(engine) = self.engine.as_mut() {
+            take_back(engine, &mut self.state);
+        }
+        self.state.as_mut()
+    }
+
+    /// `state`, where it must be: not while the engine is taken.
+    pub(super) fn state_mut(&mut self) -> &mut LoadState {
+        self.state()
+            .expect("the requests are the render thread's while no one has the engine")
+    }
+}
