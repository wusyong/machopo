+/// What `draw` gives on a thread that has drawn nothing: with no glyph
+/// in its atlas.
+fn on_a_new_thread(draw: impl FnOnce() -> crate::Bitmap + Send) -> crate::Bitmap {
+    std::thread::scope(|scope| scope.spawn(draw).join().unwrap())
+}
+
+/// A thread's glyphs are kept in its atlas, which grows to its cap and no
+/// further; the glyphs past it are drawn all the same.
+#[test]
+fn glyphs_are_kept_in_an_atlas_that_grows_to_its_cap() {
+    use crate::vello_backend::atlas_pages;
+    let black = || PaintFlags::fill(Color::BLACK);
+    assert_eq!(atlas_pages(), 0);
+    play(
+        vec![text_run((AHEM, 1), "X", 20.0, PointF::new(2.0, 18.0), 20.0, black())],
+        40.0,
+        40.0,
+    );
+    assert_eq!(atlas_pages(), 1);
+    // Each size is a glyph of its own to the atlas: four of these to a
+    // page, so these are more than its 64 pages hold.
+    let sizes = |range: std::ops::Range<u16>| -> Vec<PaintOp> {
+        range
+            .map(|i| {
+                let size = 100.0 + f32::from(i) / 64.0;
+                text_run((AHEM, 1), "X", size, PointF::new(0.0, 100.0), size, black())
+            })
+            .collect()
+    };
+    play(sizes(0..300), 120.0, 120.0);
+    assert_eq!(atlas_pages(), 64);
+    // One that found no room: drawn as on a thread whose atlas has it.
+    let last = || play(sizes(299..300), 120.0, 120.0);
+    let here = last();
+    assert_eq!(atlas_pages(), 64);
+    let there = on_a_new_thread(last);
+    assert_eq!(here.pixel(50, 50), [0, 0, 0, 255]);
+    assert_eq!(here.pixels, there.pixels);
+}
+
+/// Lato's "R" at 24px with its origin at `transform`'s, slanted by `skew`
+/// degrees: every such run asks the atlas for the same glyph at the same
+/// place within a pixel.
+fn an_r(skew: f32, transform: Transform) -> Vec<PaintOp> {
+    let mut op = text_run(
+        (LATO, 2),
+        "R",
+        24.0,
+        PointF::new(0.0, 0.0),
+        24.0,
+        PaintFlags::fill(Color::BLACK),
+    );
+    let PaintOp::DrawGlyphs { skew: its, .. } = &mut op else {
+        unreachable!()
+    };
+    *its = skew;
+    vec![
+        PaintOp::Save,
+        PaintOp::SetMatrix { transform },
+        op,
+        PaintOp::Restore,
+    ]
+}
+
+/// A glyph that is slanted, or under a matrix that turns or stretches, is
+/// drawn so whatever was drawn before it: Vello's atlas hands back the
+/// upright one of the same font, size and place that a run before it in
+/// the same playback put there.
+#[test]
+fn a_glyph_the_atlas_has_upright_is_drawn_as_its_run_has_it() {
+    let at = |x: f32| Transform([1.0, 0.0, 0.0, 1.0, x, 30.0]);
+    // By 30 degrees about its origin.
+    let turned = Transform([0.866, 0.5, -0.5, 0.866, 50.0, 30.0]);
+    let squeezed = Transform([0.5, 0.0, 0.0, 1.0, 50.0, 30.0]);
+    let tall = Transform([1.0, 0.0, 0.0, 1.25, 50.0, 30.0]);
+    let upright = play(an_r(0.0, at(50.0)), 80.0, 40.0);
+    for (what, skew, transform) in [
+        ("slanted", 20.0, at(50.0)),
+        ("turned", 0.0, turned),
+        ("squeezed", 0.0, squeezed),
+        ("tall", 0.0, tall),
+    ] {
+        let alone = on_a_new_thread(|| play(an_r(skew, transform), 80.0, 40.0));
+        assert_ne!(alone.pixels, upright.pixels, "{what}");
+        // After an upright one, 40 to its left, in the same playback.
+        let after = on_a_new_thread(|| {
+            let ops = [an_r(0.0, at(10.0)), an_r(skew, transform)].concat();
+            play(ops, 80.0, 40.0)
+        });
+        let right = |bitmap: &crate::Bitmap| -> Vec<[u8; 4]> {
+            (0..40)
+                .flat_map(|y| (40..80).map(move |x| (x, y)))
+                .map(|(x, y)| bitmap.pixel(x, y))
+                .collect()
+        };
+        assert!(right(&after) == right(&alone), "{what}");
+    }
+}
+
+/// A canvas's glyphs go through its thread's atlas too.
+#[test]
+fn a_canvas_keeps_its_glyphs_in_the_atlas() {
+    let size = Size::new(40, 40);
+    let mut pixels = vec![0u8; 40 * 40 * 4];
+    let run = text_run(
+        (AHEM, 1),
+        "X",
+        20.0,
+        PointF::new(2.0, 18.0),
+        20.0,
+        PaintFlags::fill(Color::BLACK),
+    );
+    let list = list_of(vec![run]);
+    crate::draw_into(&list, &RasterCache::default(), size, false, &mut pixels);
+    assert_eq!(crate::vello_backend::atlas_pages(), 1);
+    assert_eq!(pixels[(10 * 40 + 10) * 4..][..4], [0, 0, 0, 255]);
+}
