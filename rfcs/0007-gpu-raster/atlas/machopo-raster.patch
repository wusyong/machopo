+/// The side of a page of a thread's glyph atlas, in pixels. Before each
+/// render Vello draws the glyphs new to the atlas into a context of a
+/// page's size and composites it onto their page, which every tile with a
+/// new glyph pays for: with Vello's own 4096 the atlas cost more than it
+/// saved, and of 256, 512 and 1024 this was the fastest or as fast.
+const ATLAS_PAGE: u16 = 256;
+/// The most pages a thread's atlas grows to: 16 MB. A glyph that finds no
+/// room is drawn from its outline, as all were before.
+const ATLAS_PAGES: usize = 64;
+/// How many renders (a tile is one) a glyph nobody drew stays in the
+/// atlas. Vello's own 64 is frames of a window; of tiles it is a fraction
+/// of one frame's, and the atlas then saved nothing.
+const ATLAS_AGE: u64 = 4096;
+
+/// A context and its resources for this thread to keep, with a glyph
+/// atlas.
+fn kept_context(width: u16, height: u16) -> (RenderContext, Resources) {
+    let mut settings = vello_cpu::GlyphAtlasSettings {
+        page_size: ATLAS_PAGE,
+        max_pages: ATLAS_PAGES,
+        ..Default::default()
+    };
+    settings.cache.max_entry_age = ATLAS_AGE;
+    (
+        RenderContext::new(width, height),
+        Resources::with_glyph_atlas_settings(settings),
+    )
+}
+
+/// How many pages this thread's glyph atlas has.
+#[cfg(test)]
+pub(crate) fn atlas_pages() -> usize {
+    CONTEXT.with_borrow(|slot| {
+        slot.as_ref()
+            .map_or(0, |(_, resources)| resources.glyph_atlas_page_count())
+    })
+}
