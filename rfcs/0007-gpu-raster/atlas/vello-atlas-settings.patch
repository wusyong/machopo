diff --git a/vello_cpu/src/render.rs b/vello_cpu/src/render.rs
index c3b4b636cab7808b112ad1a060a1bdeee96354d9..a50f4a412cd89fefb733b53030bff94cef10ad47 100644
--- a/vello_cpu/src/render.rs
+++ b/vello_cpu/src/render.rs
@@ -38,6 +38,36 @@ use vello_common::util::into_fast_path_rect;
 #[cfg(feature = "text")]
 pub(crate) const DEFAULT_GLYPH_ATLAS_SIZE: u16 = 4096;
 
+/// Settings for the glyph atlas that backs
+/// [`atlas_cache`](glifo::GlyphRunBackend::atlas_cache).
+///
+/// Before each render, the glyphs that are new to the atlas are drawn into a
+/// scratch context of a page's size and composited onto their page, so the
+/// page size is a cost every such render pays: a renderer that renders many
+/// small targets wants small pages. `cache.max_entry_age` counts renders.
+#[cfg(feature = "text")]
+#[derive(Clone, Debug)]
+pub struct GlyphAtlasSettings {
+    /// Width and height of each atlas page in pixels.
+    pub page_size: u16,
+    /// The most pages the atlas grows to. A glyph that finds no room is drawn
+    /// directly, as it is without the atlas.
+    pub max_pages: usize,
+    /// When cached glyphs are evicted, and which sizes are cached at all.
+    pub cache: glifo::atlas::GlyphCacheConfig,
+}
+
+#[cfg(feature = "text")]
+impl Default for GlyphAtlasSettings {
+    fn default() -> Self {
+        Self {
+            page_size: DEFAULT_GLYPH_ATLAS_SIZE,
+            max_pages: glifo::atlas::AtlasConfig::default().max_atlases,
+            cache: glifo::atlas::GlyphCacheConfig::default(),
+        }
+    }
+}
+
 /// Persistent resources required by Vello CPU for rendering.
 ///
 /// You should create one such instance per renderer.
@@ -49,6 +79,8 @@ pub struct Resources {
     // Will be initialized lazily on first use.
     #[cfg(feature = "text")]
     pub(crate) glyph_resources: Option<GlyphAtlasResources>,
+    #[cfg(feature = "text")]
+    pub(crate) glyph_atlas_settings: GlyphAtlasSettings,
 }
 
 impl Resources {
@@ -57,6 +89,25 @@ impl Resources {
         Self::default()
     }
 
+    /// Create a new set of renderer resources whose glyph atlas, once a glyph
+    /// run asks for it, has the given settings.
+    #[cfg(feature = "text")]
+    pub fn with_glyph_atlas_settings(settings: GlyphAtlasSettings) -> Self {
+        Self {
+            glyph_atlas_settings: settings,
+            ..Self::default()
+        }
+    }
+
+    /// The number of pages the glyph atlas has allocated: each holds
+    /// `page_size` × `page_size` pixels of four bytes.
+    #[cfg(feature = "text")]
+    pub fn glyph_atlas_page_count(&self) -> usize {
+        self.glyph_resources
+            .as_ref()
+            .map_or(0, |resources| resources.pixmaps.len())
+    }
+
     pub(crate) fn before_render(&mut self, render_mode: RenderMode) {
         #[cfg(feature = "text")]
         self.prepare_glyph_cache(render_mode);
@@ -1470,4 +1521,62 @@ mod tests {
 
         assert!(resources.glyph_resources.is_some());
     }
+
+    #[cfg(feature = "text")]
+    #[test]
+    fn glyph_atlas_follows_its_settings() {
+        const ROBOTO_FONT: &[u8] = include_bytes!("../../assets/roboto/Roboto-Regular.ttf");
+
+        let font = FontData::new(Blob::new(Arc::new(ROBOTO_FONT)), 0);
+        // More glyphs than one 64x64 page holds at this size.
+        let glyphs: vec::Vec<Glyph> = (1..200)
+            .map(|id| Glyph {
+                id,
+                x: (id % 10) as f32 * 9.0,
+                y: 20.0,
+            })
+            .collect();
+        let draw = |settings: crate::GlyphAtlasSettings| {
+            let mut resources = Resources::with_glyph_atlas_settings(settings);
+            let mut ctx = RenderContext::new(100, 100);
+            let mut target = Pixmap::new(100, 100);
+            ctx.glyph_run(&mut resources, &font)
+                .font_size(16.0)
+                .atlas_cache(true)
+                .fill_glyphs(glyphs.iter().copied())
+                .unwrap();
+            ctx.flush();
+            ctx.render(&mut target, &mut resources);
+            let pages = &resources.glyph_resources.as_ref().unwrap().pixmaps;
+            let sizes: vec::Vec<(u16, u16)> =
+                pages.iter().map(|p| (p.width(), p.height())).collect();
+            assert_eq!(resources.glyph_atlas_page_count(), sizes.len());
+            (sizes, target)
+        };
+
+        let (one, with_one) = draw(crate::GlyphAtlasSettings {
+            page_size: 64,
+            max_pages: 1,
+            ..Default::default()
+        });
+        assert_eq!(one, [(64, 64)]);
+
+        let (three, with_three) = draw(crate::GlyphAtlasSettings {
+            page_size: 64,
+            max_pages: 3,
+            ..Default::default()
+        });
+        assert_eq!(three, [(64, 64); 3]);
+
+        // The glyphs that found no room were drawn all the same: directly,
+        // which rounds a level apart from compositing them from the atlas.
+        let worst = with_one
+            .data()
+            .iter()
+            .zip(with_three.data())
+            .map(|(a, b)| a.a.abs_diff(b.a))
+            .max();
+        assert!(worst <= Some(1), "{worst:?}");
+        assert!(with_one.data().iter().any(|p| p.a != 0));
+    }
 }
