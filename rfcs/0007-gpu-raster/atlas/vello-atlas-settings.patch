             glyph_renderer: Box::new(RenderContext::new_with(
                 page_width,
                 page_height,
@@ -117,11 +117,9 @@ impl Resources {
 
     fn ensure_glyph_resources(&mut self, level: Level) {
         if self.glyph_resources.is_none() {
