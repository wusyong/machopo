+thread_local! {
+    /// PROTOTYPE: names found by their V8 string's identity. A slot by
+    /// the string's hash: the internalized string's address, its name's
+    /// number and its element's interface. (A real one would hold the
+    /// string by a handle, whose address a GC updates; this trusts the
+    /// address.)
+    static NAME_IDENTITIES: std::cell::Cell<[(usize, u32, u32); 256]> =
+        const { std::cell::Cell::new([(0, 0, 0); 256]) };
+    pub(crate) static NAME_IDENTITY_HITS: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+}
+
 #[inline(always)]
 fn foresee_element_parts(
     isolate: &v8::Isolate,
     name: &ArgString<'_>,
+) -> (Option<dom::NameId>, usize) {
+    let identity = v8::machopo::internalized_identity(name.v8_string());
+    if let Some((hash, address)) = identity {
+        let slot = (hash >> 2) as usize & 255;
+        let found = NAME_IDENTITIES.with(|slots| {
+            // SAFETY-free read of one slot: the array is `Copy` in a `Cell`.
+            let slots = slots.as_array_of_cells();
+            slots[slot].get()
+        });
+        if found.0 == address {
+            NAME_IDENTITY_HITS.set(NAME_IDENTITY_HITS.get().wrapping_add(1));
+            return (Some(found.1), found.2 as usize);
+        }
+    }
+    let (id, interface) = foresee_element_slow(isolate, name);
+    if let (Some((hash, address)), Some(id)) = (identity, id) {
+        let slot = (hash >> 2) as usize & 255;
+        NAME_IDENTITIES.with(|slots| {
+            slots.as_array_of_cells()[slot].set((address, id, interface as u32));
+        });
+    }
+    (id, interface)
+}
