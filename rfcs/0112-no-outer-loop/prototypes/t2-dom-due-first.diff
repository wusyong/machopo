+    fn earliest_due_task(&mut self) -> Option<std::time::Instant> {
+        let State { dom, frames, .. } = self.state();
+        dom.read(|cx| {
+            let now = cx.dom_now();
+            let at = frames
+                .iter()
+                .filter_map(|frame| {
+                    let window = cx.window_of(frame.document.get(cx.gc))?;
+                    cx.next_task(cx.window_context(window), now).map(|task| task.at)
+                })
+                .min_by(f64::total_cmp)?;
+            // The DOM's clock is milliseconds; how long ago that was.
+            let ago = std::time::Duration::from_secs_f64(((now - at) / 1000.0).max(0.0));
+            std::time::Instant::now().checked_sub(ago)
+        })
+    }
