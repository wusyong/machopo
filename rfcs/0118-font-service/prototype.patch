diff --git a/crates/layout/src/text.rs b/crates/layout/src/text.rs
index bd519aaf..8a9133c3 100644
--- a/crates/layout/src/text.rs
+++ b/crates/layout/src/text.rs
@@ -51,6 +51,198 @@ pub struct TextContext {
     layout: LayoutContext<u32>,
     /// What each `font-family` value shaped so far is in `fonts`.
     families: FontFallbackMap,
