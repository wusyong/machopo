+
+/// PROTOTYPE: the system's fonts as a browser would have them, and what
+/// of them the renderer's collection was given so far.
+struct Relay {
+    system: FontContext,
+    /// A system family's name, lower case, and what it is in the
+    /// renderer's collection.
+    families: rustc_hash::FxHashMap<String, Option<parley::fontique::FamilyId>>,
+    /// A font file's faces as registered.
+    files: rustc_hash::FxHashMap<
+        u64,
+        Vec<(parley::fontique::FamilyId, Vec<parley::fontique::FontInfo>)>,
+    >,
+    prepared: bool,
+    /// Fallbacks only for the scripts texts have had.
+    lazy: bool,
+    scripts: rustc_hash::FxHashSet<[u8; 4]>,
+}
+
+impl Relay {
+    fn family(&mut self, fonts: &mut FontContext, name: &str) -> Option<parley::fontique::FamilyId> {
+        let key = name.to_lowercase();
+        if let Some(known) = self.families.get(&key) {
+            return *known;
+        }
+        let started = std::time::Instant::now();
+        let mut ours = None;
+        let mut split = false;
+        if let Some(family) = self.system.collection.family_by_name(name) {
+            for font in family.fonts() {
+                let source = font.source().clone();
+                let id = source.id().to_u64();
+                if !self.files.contains_key(&id) {
+                    let registered = match self.system.source_cache.get(&source) {
+                        Some(blob) => {
+                            let single = !matches!(
+                                read_fonts::FileRef::new(blob.as_ref()),
+                                Ok(read_fonts::FileRef::Collection(_))
+                            );
+                            // A file of one face is the system's family's
+                            // as the system has it; a collection's faces
+                            // are whatever families they name.
+                            let over = single.then(|| parley::fontique::FontInfoOverride {
+                                family_name: Some(family.name()),
+                                width: Some(font.width()),
+                                style: Some(font.style()),
+                                weight: Some(font.weight()),
+                                axes: None,
+                            });
+                            eprintln!(
+                                "FONTRELAY file bytes={} collection={}",
+                                blob.len(),
+                                !single
+                            );
+                            fonts.collection.register_fonts(blob, over)
+                        }
+                        None => Vec::new(),
+                    };
+                    self.files.insert(id, registered);
+                }
+                let found = self.files[&id].iter().find_map(|(family, infos)| {
+                    infos
+                        .iter()
+                        .any(|info| info.index() == font.index())
+                        .then_some(*family)
+                });
+                match (ours, found) {
+                    (None, Some(found)) => ours = Some(found),
+                    (Some(first), Some(found)) if first != found => split = true,
+                    _ => {}
+                }
+            }
+        }
+        let named = ours.and_then(|id| fonts.collection.family_name(id).map(str::to_owned));
+        eprintln!(
+            "FONTRELAY family {name:?} -> {named:?} split={split} us={}",
+            started.elapsed().as_micros()
+        );
+        self.families.insert(key, ours);
+        ours
+    }
+
+    /// Before `text` is shaped: the fallback of each script it has a
+    /// character of, and Han's (which the shaper asks of every text), for
+    /// those not asked before.
+    fn scripts_of(&mut self, fonts: &mut FontContext, text: &str) {
+        use parley::fontique::{FallbackKey, Script};
+        if !self.lazy {
+            return;
+        }
+        let names = icu_properties::PropertyNamesShort::<icu_properties::props::Script>::new();
+        let scripts = icu_properties::CodePointMapData::<icu_properties::props::Script>::new();
+        let mut new: Vec<[u8; 4]> = Vec::new();
+        if self.scripts.insert(*b"Hani") {
+            new.push(*b"Hani");
+        }
+        for ch in text.chars() {
+            let Some(name) = names.get(scripts.get(ch)) else {
+                continue;
+            };
+            let Ok(tag) = <[u8; 4]>::try_from(name.as_bytes()) else {
+                continue;
+            };
+            if self.scripts.insert(tag) {
+                new.push(tag);
+            }
+        }
+        for tag in new {
+            let key = FallbackKey::new(Script::from_bytes(tag), None);
+            let ids: Vec<_> = self.system.collection.fallback_families(key).collect();
+            let names: Vec<String> = ids
+                .into_iter()
+                .filter_map(|id| self.system.collection.family_name(id).map(str::to_owned))
+                .collect();
+            let ours: Vec<_> = names
+                .iter()
+                .filter_map(|name| self.family(fonts, name))
+                .collect();
+            eprintln!(
+                "FONTRELAY script {} -> {names:?}",
+                String::from_utf8_lossy(&tag)
+            );
+            if !ours.is_empty() {
+                fonts.collection.set_fallbacks(key, ours.into_iter());
+            }
+        }
+    }
+
+    /// Before a layout with `families`: the generic families and every
+    /// script's fallback once, then the families named.
+    fn prepare(&mut self, fonts: &mut FontContext, families: &[computed_style::FontFamily]) {
+        use parley::fontique::{FallbackKey, Script, ScriptExt as _};
+        if !self.prepared {
+            self.prepared = true;
+            let started = std::time::Instant::now();
+            for &generic in parley::GenericFamily::all() {
+                let ids: Vec<_> = self.system.collection.generic_families(generic).collect();
+                let names: Vec<String> = ids
+                    .into_iter()
+                    .filter_map(|id| self.system.collection.family_name(id).map(str::to_owned))
+                    .collect();
+                let ours: Vec<_> = names
+                    .iter()
+                    .filter_map(|name| self.family(fonts, name))
+                    .collect();
+                fonts.collection.set_generic_families(generic, ours.into_iter());
+            }
+            eprintln!("FONTRELAY generics us={}", started.elapsed().as_micros());
+            let started = std::time::Instant::now();
+            let mut keys = 0;
+            let all: &[(Script, &str)] = if self.lazy { &[] } else { Script::all_samples() };
+            for (script, _) in all {
+                let mut locales: Vec<Option<&str>> = vec![None];
+                if &script.to_bytes() == b"Hani" {
+                    locales.extend([Some("zh-Hans"), Some("zh-Hant"), Some("ja"), Some("ko")]);
+                }
+                for locale in locales {
+                    let key = match locale {
+                        Some(locale) => FallbackKey::from((*script, locale)),
+                        None => FallbackKey::new(*script, None),
+                    };
+                    let ids: Vec<_> = self.system.collection.fallback_families(key).collect();
+                    let names: Vec<String> = ids
+                        .into_iter()
+                        .filter_map(|id| self.system.collection.family_name(id).map(str::to_owned))
+                        .collect();
+                    let ours: Vec<_> = names
+                        .iter()
+                        .filter_map(|name| self.family(fonts, name))
+                        .collect();
+                    if !ours.is_empty() {
+                        keys += 1;
+                        fonts.collection.set_fallbacks(key, ours.into_iter());
+                    }
+                }
+            }
+            eprintln!(
+                "FONTRELAY fallbacks keys={keys} us={}",
+                started.elapsed().as_micros()
+            );
+        }
+        for family in crate::font_families::font_stack(families, crate::font_families::Platform::CURRENT)
+        {
+            if let parley::FontFamilyName::Named(name) = family {
+                self.family(fonts, &name);
+            }
+        }
+    }
 }
 
